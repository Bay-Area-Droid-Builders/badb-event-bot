# Copy this file to .env.yaml and fill in real values.
# .env.yaml is gitignored — never commit it.

# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN: "PASTE_BOT_TOKEN_HERE"

# Discord Developer Portal > General Information > Public Key
DISCORD_PUBLIC_KEY: "PASTE_PUBLIC_KEY_HERE"

# The Discord server (guild) ID the bot operates in
DISCORD_GUILD_ID: "PASTE_GUILD_ID_HERE"

# The admin channel ID where new-event-request messages get posted
DISCORD_ADMIN_CHANNEL_ID: "PASTE_ADMIN_CHANNEL_ID_HERE"

# The public channel ID where new-event announcements get posted
DISCORD_ANNOUNCEMENT_CHANNEL_ID: "PASTE_ANNOUNCEMENT_CHANNEL_ID_HERE"

# Shared secret between the Apps Script trigger and the formSubmit function.
# Must match SHARED_SECRET in appsscript/onFormSubmit.js.
FORM_SHARED_SECRET: "PICK_A_RANDOM_SECRET_STRING"

# Google Calendar that is the source of truth for events. The club account
# below needs "Make changes to events" on it. Paste its Calendar ID here
# (Calendar Settings > Integrate calendar).
GOOGLE_CALENDAR_ID: "PASTE_CALENDAR_ID_HERE"

# The bot acts on Calendar as the club Google account, so it can add RSVPs
# to the guest list. Create a "Desktop app" OAuth client (Google Cloud
# Console > APIs & Services > Credentials), then run
#   node scripts/authorize-calendar.js <client ID> <client secret>
# and sign in as the club account to get the refresh token.
GOOGLE_OAUTH_CLIENT_ID: "PASTE_OAUTH_CLIENT_ID_HERE"
GOOGLE_OAUTH_CLIENT_SECRET: "PASTE_OAUTH_CLIENT_SECRET_HERE"
GOOGLE_OAUTH_REFRESH_TOKEN: "PASTE_REFRESH_TOKEN_HERE"

# The rsvp function's trigger URL, used in RSVP links (Discord buttons,
# emails, and confirmation links).
RSVP_PAGE_URL: "https://us-west1-PROJECT_ID.cloudfunctions.net/badb-rsvp"

# Signs RSVP confirmation links, the RSVP page's "remember me" cookie, and
# Discord RSVP links. Generate one with: openssl rand -base64 32
# Changing it signs everyone out of the RSVP page and voids pending links.
RSVP_SIGNING_SECRET: "PICK_A_LONG_RANDOM_SECRET"

# Gmail account used to send email — the digest, new-event announcements,
# and RSVP confirmations — via SMTP with an app password. Requires 2FA on
# the account first: Google Account > Security > 2-Step Verification >
# App passwords.
GMAIL_SENDER_EMAIL: "PASTE_GMAIL_ADDRESS_HERE"
GMAIL_APP_PASSWORD: "PASTE_APP_PASSWORD_HERE"
